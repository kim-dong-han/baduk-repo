# ---------------------------------------------------------------
# 이 파일은 "형식"만 담는다. 복사해서 .env.local 을 만든다.
#   cp .env.example .env.local
#
# 주의: 이 프로젝트는 브라우저에서만 도는 SPA 다.
# VITE_ 로 시작하는 값은 전부 번들에 포함되어 사용자에게 노출된다.
# Secret(토큰, 키, 비밀번호)을 여기에 넣지 않는다.
# 서버 전용 Secret 은 Spring Boot 백엔드가 갖는다.
# ---------------------------------------------------------------

# Spring Boot 백엔드 주소
# local : http://localhost:8080
# prod  : https://<render-service>.onrender.com
VITE_API_BASE_URL=http://localhost:8080

# 이 프론트엔드 자신의 주소 (절대 URL 생성, OG 태그 등에 쓴다)
# local : http://localhost:5173
# prod  : https://<vercel-domain>
VITE_APP_URL=http://localhost:5173

# MSW 목 API 사용 여부. 백엔드 없이 화면을 개발할 때 true.
# 프로덕션에서는 반드시 false 다.
VITE_ENABLE_API_MOCKING=true
