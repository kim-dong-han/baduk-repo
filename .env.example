# ---------------------------------------------------------------
# 이 파일은 "형식"만 담는다. 실제 값(특히 Secret)은 커밋하지 않는다.
# 복사해서 .env.local 을 만든 뒤 값을 채운다.
#   cp .env.example .env.local
# ---------------------------------------------------------------

# Spring Boot 백엔드 주소
# local  : http://localhost:8080
# prod   : https://<render-service>.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# 이 프론트엔드 자신의 주소 (metadata / OG / 절대 URL 생성에 쓰인다)
# local  : http://localhost:3000
# prod   : https://<vercel-domain>
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MSW 목 API 사용 여부. 백엔드 없이 화면을 개발할 때만 true.
NEXT_PUBLIC_ENABLE_API_MOCKING=false

# ---------------------------------------------------------------
# 서버 전용 Secret 은 NEXT_PUBLIC_ 접두사를 붙이지 않는다.
# 클라이언트 번들에 포함되면 안 되는 값들이며,
# src/lib/config/server-env.ts 의 스키마에 등록해 사용한다.
# 현재 필요한 값은 없다. 생기면 아래에 키 이름만 추가한다.
# ---------------------------------------------------------------
# INTERNAL_API_TOKEN=
